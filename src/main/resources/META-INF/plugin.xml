<idea-plugin>
    <id>com.forge.fl</id>
    <name>Forge FL</name>
    <version>0.1.0</version>
    <vendor email="david@darkcollective.com" url="https://github.com/DarkCollective/forge">DarkCollective</vendor>

    <description><![CDATA[
        Language support for the FL language used by the Forge project: highlighting, name resolution across files and into the built-in words, find usages, rename and completion.
    ]]></description>

    <depends>com.intellij.modules.lang</depends>


    <extensions defaultExtensionNs="com.intellij">
        <fileType name="FL / FTH"
                  language="FL"
                  implementationClass="com.forge.fl.FLFileType"
                  fieldName="INSTANCE"
                  extensions="fl;fth;forge"/>

        <lang.parserDefinition language="FL" implementationClass="com.forge.fl.parser.FLParserDefinition"/>
        <lang.formatter language="FL" implementationClass="com.forge.fl.formatting.FLFormattingModelBuilder"/>
        <postFormatProcessor implementation="com.forge.fl.formatting.FLTrailingWhitespaceProcessor"/>
        <langCodeStyleSettingsProvider implementation="com.forge.fl.formatting.FLLanguageCodeStyleSettingsProvider"/>
        <lang.syntaxHighlighterFactory language="FL" implementationClass="com.forge.fl.highlighting.FLSyntaxHighlighterFactory"/>
        <lang.braceMatcher language="FL" implementationClass="com.forge.fl.editor.FLBraceMatcher"/>
        <lang.commenter language="FL" implementationClass="com.forge.fl.editor.FLCommenter"/>
        <lang.psiStructureViewFactory language="FL" implementationClass="com.forge.fl.editor.FLStructureViewFactory"/>
        <lang.findUsagesProvider language="FL" implementationClass="com.forge.fl.psi.FLFindUsagesProvider"/>
        <lang.refactoringSupport language="FL" implementationClass="com.forge.fl.psi.FLRefactoringSupportProvider"/>
        <renamePsiElementProcessor implementation="com.forge.fl.psi.FLRenamePsiElementProcessor"/>
        <lang.namesValidator language="FL" implementationClass="com.forge.fl.psi.FLNamesValidator"/>
        <renameInputValidator implementation="com.forge.fl.psi.FLParameterRenameValidator"/>
        <colorSettingsPage implementation="com.forge.fl.editor.FLColorSettingsPage"/>
        <fileBasedIndex implementation="com.forge.fl.index.FLIndex"/>
        <additionalLibraryRootsProvider implementation="com.forge.fl.builtins.FLBuiltinsLibraryProvider"/>
        <referencesSearch implementation="com.forge.fl.search.FLReferencesSearcher"/>
        <vetoRenameCondition implementation="com.forge.fl.psi.FLRenameVeto"/>
        <postStartupActivity implementation="com.forge.fl.builtins.FLBuiltinsStartup"/>
        <annotator language="FL" implementationClass="com.forge.fl.diagnostics.FLAnnotator"/>
        <localInspection language="FL" shortName="FLTopLevelCode" displayName="Executable code outside a definition"
                         groupName="FL" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.forge.fl.diagnostics.FLTopLevelCodeInspection"/>
        <localInspection language="FL" shortName="FLShadow" displayName="Parameter hides a word"
                         groupName="FL" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.forge.fl.diagnostics.FLShadowInspection"/>
        <localInspection language="FL" shortName="FLMetaPlacement" displayName="META block not next to definition"
                         groupName="FL" enabledByDefault="true" level="WARNING" cleanupTool="true"
                         implementationClass="com.forge.fl.diagnostics.FLMetaPlacementInspection"/>
        <annotator language="FL" implementationClass="com.forge.fl.highlighting.FLSemanticAnnotator"/>
        <lang.documentationProvider language="FL" implementationClass="com.forge.fl.doc.FLDocumentationProvider"/>
        <gotoSymbolContributor implementation="com.forge.fl.navigation.FLGotoSymbolContributor"/>
        <lang.foldingBuilder language="FL" implementationClass="com.forge.fl.editor.FLFoldingBuilder"/>
        <typedHandler implementation="com.forge.fl.editor.FLTypedHandler"/>
        <quoteHandler fileType="FL / FTH" className="com.forge.fl.editor.FLQuoteHandler"/>
        <breadcrumbsInfoProvider implementation="com.forge.fl.editor.FLBreadcrumbsProvider"/>
        <indexPatternBuilder implementation="com.forge.fl.editor.FLIndexPatternBuilder"/>
        <completion.contributor language="FL" implementationClass="com.forge.fl.completion.FLCompletionContributor"/>
        <intentionAction>
            <className>com.forge.fl.intentions.FLMoveMetaBlockIntention</className>
            <category>FL</category>
        </intentionAction>
    </extensions>
</idea-plugin>
